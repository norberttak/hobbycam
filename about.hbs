<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>HobbyCAM third-party licences</title>
<style>body{font-family:sans-serif;max-width:60em;margin:auto;padding:1em}pre{white-space:pre-wrap;background:#f4f4f4;padding:1em}</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>HobbyCAM is GPL-3.0-or-later. It contains the following third-party Rust crates.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li>{{name}} ({{count}})</li>
{{/each}}
</ul>
<h2>Licences</h2>
{{#each licenses}}
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
